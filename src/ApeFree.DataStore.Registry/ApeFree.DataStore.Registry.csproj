<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;net8.0-windows;net10.0-windows</TargetFrameworks>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<NoWarn>$(NoWarn);CA1416</NoWarn>
		<Title>ApeFree.DataStore.Registry</Title>
		<PackageTags>storage;persistence;serialization;registry;windows</PackageTags>
		<Description>基于 ApeFree.DataStore 提供 Windows 注册表存储器的实现扩展包。</Description>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="STTech.CodePlus" Version="1.8.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApeFree.DataStore\ApeFree.DataStore.csproj" />
	</ItemGroup>

</Project>
